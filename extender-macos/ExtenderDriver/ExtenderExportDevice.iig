#ifndef ExtenderExportDevice_h
#define ExtenderExportDevice_h

#include <Availability.h>
#include <DriverKit/IOService.iig>

// Forward declaration of the provider type.
class IOUSBHostDevice;

// ExtenderExportDevice is the export-side counterpart of the virtual device
// classes. It matches an IOUSBHostDevice (a real USB device on the host) and
// claims it on behalf of the userspace daemon, which then forwards URBs to a
// remote USB/IP client.
//
// Per-device opt-in (so we don't grab every USB device that plugs in) is
// achieved by NOT publishing this class as an auto-matching personality —
// instead, the daemon explicitly creates an ExtenderExportDevice instance via
// IOService::Create() against a chosen IOUSBHostDevice provider.
class ExtenderExportDevice : public IOService
{
public:
    virtual bool init() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    // Synchronous USB control transfer issued on the daemon's behalf.
    // For scaffold: stubbed, returns kIOReturnUnsupported.
    kern_return_t submitControlTransfer(uint8_t requestType,
                                        uint8_t request,
                                        uint16_t value,
                                        uint16_t index,
                                        const void * outData,
                                        uint16_t outLen,
                                        void * inData,
                                        uint16_t * inLen) LOCALONLY;

    // Pull the next pending response generated by the device (e.g., an
    // interrupt-IN report). For scaffold: stub, returns false.
    bool dequeuePendingResponse(void * hdrOut, void * bufOut, uint32_t maxLen, uint32_t * outLen) LOCALONLY;
};

#endif /* ExtenderExportDevice_h */
